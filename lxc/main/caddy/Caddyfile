{$DOMAIN}, *.{$DOMAIN} {
        tls internal

        # PiHole
        @pihole host pihole.{$DOMAIN}
        handle @pihole {
                reverse_proxy http://{$PIHOLE_HOST}
        }

        # Frigate
        @frigate host frigate.{$DOMAIN}
        handle @frigate {
                reverse_proxy http://{$FRIGATE_HOST}:5000
        }

        # Jellyfin
        @jellyfin host jellyfin.{$DOMAIN}
        handle @jellyfin {
                reverse_proxy http://{$JELLYFIN_HOST}:8096
        }

        # Servarr
        @qbittorrent host qbittorrent.{$DOMAIN}
        handle @qbittorrent {
                reverse_proxy http://{$SERVARR_HOST}:5080
        }

        @prowlarr host prowlarr.{$DOMAIN}
        handle @prowlarr {
                reverse_proxy http://{$SERVARR_HOST}:9696
        }

        @radarr host radarr.{$DOMAIN}
        handle @radarr {
                reverse_proxy http://{$SERVARR_HOST}:7878
        }

        @sonarr host sonarr.{$DOMAIN}
        handle @sonarr {
                reverse_proxy http://{$SERVARR_HOST}:8989
        }

        @bazarr host bazarr.{$DOMAIN}
        handle @bazarr {
                reverse_proxy http://{$SERVARR_HOST}:6767
        }

        handle @bazarr {
                reverse_proxy http://{$SERVARR_HOST}:6767
        }

        handle *.{$DOMAIN} {
                redir /
        }

        reverse_proxy http://homerr:8080
}
